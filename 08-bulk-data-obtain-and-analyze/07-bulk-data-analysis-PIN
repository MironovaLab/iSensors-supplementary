library(Seurat)
library(tidyverse)

in_path <- "01-bulk-data-obtain-and-analyze/Data/"
out_path <- "01-bulk-data-obtain-and-analyze/Out/"

dir.create(out_path, recursive = TRUE, showWarnings = FALSE)

pseudocells <- readRDS(file.path(in_path, "seurat_auxin_microarrays_no_cb.rds"))

pin_map <- c(
  PIN1 = "AT1G73590",
  PIN2 = "AT5G57090",
  PIN3 = "AT1G70940",
  PIN4 = "AT2G01420",
  PIN5 = "AT5G16530",
  PIN6 = "AT2G01980",
  PIN7 = "AT1G23080",
  PIN8 = "AT5G15100"
)

norm_mat <- GetAssayData(pseudocells, assay = "RNA", layer = "data")
pin_present <- pin_map[pin_map %in% rownames(norm_mat)]

if (length(pin_present) == 0) {
  stop("None of the canonical Arabidopsis PIN genes were found in the RNA assay.")
}

pin_matrix <- as.matrix(norm_mat[pin_present, , drop = FALSE])
rownames(pin_matrix) <- names(pin_present)

meta <- pseudocells@meta.data %>%
  rownames_to_column("sample") %>%
  mutate(
    condition = case_when(
      str_to_lower(orig.ident) %in% c("control", "ctr", "c") ~ "Control",
      str_to_lower(orig.ident) %in% c("treat", "treatment", "aux") ~ "Auxin",
      TRUE ~ as.character(orig.ident)
    ),
    condition = factor(condition, levels = c("Control", "Auxin"))
  ) %>%
  arrange(Author, Batch, condition, sample)

concentration_map <- tribble(
  ~dataset_dir, ~label,
  "auxin_seedling_2h_okushima", "Auxin (IAA 5uM)",
  "auxin_root_2h_vanneste", "Auxin (IAA 10uM)",
  "auxin_root_6h_vanneste", "Auxin (IAA 10uM)",
  "auxin_root_4h_stepanova", "Auxin (IAA 1uM)",
  "auxin_seedling_05h_delker", "Auxin (IAA 1uM)",
  "auxin_seedling_1h_delker", "Auxin (IAA 1uM)",
  "auxin_seedling_3h_delker", "Auxin (IAA 1uM)",
  "auxin_root_2h_bargmann", "Auxin (IAA 5uM)",
  "auxin_root_05h_lewis", "Auxin (IAA 1uM)",
  "auxin_root_1h_lewis", "Auxin (IAA 1uM)",
  "auxin_root_2h_lewis", "Auxin (IAA 1uM)",
  "auxin_root_4h_lewis", "Auxin (IAA 1uM)",
  "auxin_root_8h_lewis", "Auxin (IAA 1uM)",
  "auxin_root_12h_lewis", "Auxin (IAA 1uM)",
  "auxin_root_24h_lewis", "Auxin (IAA 1uM)",
  "auxin_root_2h_derybel", "Auxin (NAA 10uM)",
  "auxin_root_6h_derybel", "Auxin (NAA 10uM)",
  "auxin_seedling_3h_shimada", "Auxin (IAA 1uM)",
  "auxin_root-apex_6h_xuan", "Auxin (IBA 10uM)",
  "auxin_cauline-buds_18h_muller", "Auxin (NAA 1uM)",
  "auxin_leaves_72h_romero-puertas", "Auxin (NAA 10uM)"
) %>%
  mutate(
    auxin_compound = case_when(
      str_detect(label, "IAA") ~ "IAA",
      str_detect(label, "NAA") ~ "NAA",
      str_detect(label, "IBA") ~ "IBA",
      TRUE ~ NA_character_
    ),
    concentration_value = as.numeric(str_extract(label, "\\d+(?:\\.\\d+)?")),
    concentration_unit = str_extract(label, "(uM|mM)"),
    concentration_uM = case_when(
      concentration_unit == "uM" ~ concentration_value,
      concentration_unit == "mM" ~ concentration_value * 1000,
      TRUE ~ NA_real_
    )
  )

meta <- meta %>%
  mutate(
    group = case_when(
      str_detect(sample, "^control_") ~ "control",
      str_detect(sample, "^treat_") ~ "treat",
      TRUE ~ NA_character_
    ),
    dataset_dir = str_replace(sample, "^(control|treat)_\\d+_?", "")
  ) %>%
  left_join(
    concentration_map %>%
      select(dataset_dir, concentration_uM, auxin_compound, label),
    by = "dataset_dir"
  ) %>%
  mutate(
    Concentration = case_when(
      group == "control" ~ 0,
      group == "treat" ~ concentration_uM,
      TRUE ~ NA_real_
    )
  )

sample_order <- meta$sample
pin_matrix <- pin_matrix[, sample_order, drop = FALSE]

pin_table <- pin_matrix %>%
  as.data.frame() %>%
  rownames_to_column("gene") %>%
  pivot_longer(cols = -gene, names_to = "sample", values_to = "normalized_expression") %>%
  left_join(meta, by = "sample")

write.csv(
  pin_table,
  file = file.path(out_path, "07-PIN-normalized-expression-long.csv"),
  row.names = FALSE
)

write.csv(
  cbind(gene = rownames(pin_matrix), as.data.frame(pin_matrix)),
  file = file.path(out_path, "07-PIN-normalized-expression-matrix.csv"),
  row.names = FALSE
)

write.csv(
  meta,
  file = file.path(out_path, "07-PIN-sample-metadata.csv"),
  row.names = FALSE
)

heatmap_plot <- ggplot(
  pin_table,
  aes(x = factor(sample, levels = sample_order), y = factor(gene, levels = rev(names(pin_present))), fill = normalized_expression)
) +
  geom_tile() +
  scale_fill_gradientn(
    colours = c("#f7fcf5", "#74c476", "#00441b"),
    name = "Normalized\nexpression"
  ) +
  labs(
    title = "Arabidopsis PIN Gene Expression in Bulk Auxin Microarrays",
    x = "Sample",
    y = "PIN gene"
  ) +
  facet_grid(. ~ condition, scales = "free_x", space = "free_x") +
  theme_minimal(base_size = 11) +
  theme(
    axis.text.x = element_blank(),
    axis.ticks.x = element_blank(),
    panel.grid = element_blank(),
    strip.text.x = element_text(face = "bold"),
    axis.title.x = element_text(margin = margin(t = 8)),
    axis.title.y = element_text(margin = margin(r = 8))
  )

ggsave(
  filename = file.path(out_path, "07-PIN-normalized-expression-heatmap.png"),
  plot = heatmap_plot,
  width = 16,
  height = 4.5,
  dpi = 300
)

ggsave(
  filename = file.path(out_path, "07-PIN-normalized-expression-heatmap.pdf"),
  plot = heatmap_plot,
  width = 16,
  height = 4.5
)

if (requireNamespace("svglite", quietly = TRUE)) {
  ggsave(
    filename = file.path(out_path, "07-PIN-normalized-expression-heatmap.svg"),
    plot = heatmap_plot,
    width = 16,
    height = 4.5
  )
}

dose_data <- pin_table %>%
  filter(
    as.character(Duration) == "2h",
    !is.na(Concentration)
  ) %>%
  mutate(
    Concentration = as.numeric(Concentration),
    gene = factor(gene, levels = names(pin_present)),
    auxin_compound = replace_na(auxin_compound, "Control")
  ) %>%
  arrange(gene, Concentration, auxin_compound, sample)

write.csv(
  dose_data,
  file = file.path(out_path, "07-PIN-dose-response-2h-long.csv"),
  row.names = FALSE
)

dose_plot <- ggplot(
  dose_data,
  aes(x = Concentration, y = normalized_expression, color = auxin_compound)
) +
  geom_point(size = 2, alpha = 0.85, position = position_jitter(width = 0.12, height = 0)) +
  geom_smooth(
    aes(group = auxin_compound),
    method = "lm",
    formula = y ~ x,
    se = FALSE,
    linewidth = 0.7
  ) +
  facet_wrap(~ gene, scales = "free_y", ncol = 4) +
  scale_color_manual(
    values = c(
      "IAA" = "#1b9e77",
      "NAA" = "#d95f02",
      "IBA" = "#7570b3",
      "Control" = "#666666"
    ),
    name = "Compound"
  ) +
  scale_x_continuous(breaks = sort(unique(dose_data$Concentration))) +
  labs(
    title = "Dose-Dependent PIN Response at 2 Hours",
    subtitle = "Normalized expression across exogenous auxin concentrations",
    x = "Exogenous auxin concentration (uM)",
    y = "Normalized PIN expression"
  ) +
  theme_classic(base_size = 11) +
  theme(
    strip.background = element_blank(),
    strip.text = element_text(face = "bold"),
    legend.position = "bottom"
  )

ggsave(
  filename = file.path(out_path, "07-PIN-dose-response-2h.png"),
  plot = dose_plot,
  width = 10,
  height = 6,
  dpi = 300
)

ggsave(
  filename = file.path(out_path, "07-PIN-dose-response-2h.pdf"),
  plot = dose_plot,
  width = 10,
  height = 6
)

if (requireNamespace("svglite", quietly = TRUE)) {
  ggsave(
    filename = file.path(out_path, "07-PIN-dose-response-2h.svg"),
    plot = dose_plot,
    width = 10,
    height = 6
  )
}

dose_data_iaa <- pin_table %>%
  filter(
    as.character(Duration) == "2h",
    auxin_compound == "IAA",
    gene %in% c("PIN1", "PIN2", "PIN3", "PIN4", "PIN7"),
    !is.na(Concentration)
  ) %>%
  mutate(
    Concentration = as.numeric(Concentration),
    gene = factor(gene, levels = c("PIN1", "PIN2", "PIN3", "PIN4", "PIN7"))
  ) %>%
  arrange(gene, Concentration, sample)

write.csv(
  dose_data_iaa,
  file = file.path(out_path, "07-PIN-dose-response-2h-IAA-only-long.csv"),
  row.names = FALSE
)

dose_stats_iaa <- dose_data_iaa %>%
  group_by(gene) %>%
  group_modify(~ {
    fit <- lm(
      normalized_expression ~ poly(Concentration, 2, raw = TRUE),
      data = .x
    )
    tibble(
      r_squared = summary(fit)$r.squared,
      p_value = anova(fit)[["Pr(>F)"]][1],
      x = max(.x$Concentration, na.rm = TRUE),
      y = max(.x$normalized_expression, na.rm = TRUE)
    )
  }) %>%
  ungroup() %>%
  mutate(
    stat_label = paste0(
      "Quadratic fit\nR2 = ", formatC(r_squared, format = "f", digits = 2),
      "\nP = ", format.pval(p_value, digits = 2, eps = 1e-3)
    )
  )

dose_plot_iaa <- ggplot(
  dose_data_iaa,
  aes(x = Concentration, y = normalized_expression)
) +
  geom_point(
    color = "#1b9e77",
    size = 2.2,
    alpha = 0.9,
    position = position_jitter(width = 0.12, height = 0)
  ) +
  geom_smooth(
    method = "lm",
    formula = y ~ poly(x, 2, raw = TRUE),
    se = TRUE,
    color = "#0b5d49",
    fill = "#a6d9c8",
    linewidth = 0.8
  ) +
  geom_text(
    data = dose_stats_iaa,
    aes(x = x, y = y, label = stat_label),
    inherit.aes = FALSE,
    hjust = 1.02,
    vjust = 1.1,
    size = 3
  ) +
  facet_wrap(~ gene, scales = "free_y", ncol = 3) +
  scale_x_continuous(breaks = sort(unique(dose_data_iaa$Concentration))) +
  labs(
    title = "IAA Dose-Dependent PIN Response at 2 Hours",
    subtitle = "PIN1-PIN4 and PIN7 with quadratic trend fits",
    x = "Exogenous IAA concentration (uM)",
    y = "Normalized PIN expression"
  ) +
  theme_classic(base_size = 11) +
  theme(
    strip.background = element_blank(),
    strip.text = element_text(face = "bold")
  )

ggsave(
  filename = file.path(out_path, "07-PIN-dose-response-2h-IAA-only.png"),
  plot = dose_plot_iaa,
  width = 9,
  height = 7,
  dpi = 300
)

ggsave(
  filename = file.path(out_path, "07-PIN-dose-response-2h-IAA-only.pdf"),
  plot = dose_plot_iaa,
  width = 9,
  height = 7
)

if (requireNamespace("svglite", quietly = TRUE)) {
  ggsave(
    filename = file.path(out_path, "07-PIN-dose-response-2h-IAA-only.svg"),
    plot = dose_plot_iaa,
    width = 9,
    height = 7
  )
}

